censorPercentage1 <- 0.1
censorPercentage2 <- 0.5
n1 <- 200
n2<- 500
lambda <- 0.05
#censoring dist family = uniform (for now)
times <- rexp(n1, lambda)
#find cmaxes
cmaxValues10Prc <- seq(1, max(times), by = 1)
empCensoredvals10Prc <- sapply(cmaxValues10Prc, function(cmax){
cnes <- runif(n1, 0, cmax)
mean(times > cnes)
})
data.frame(cmax = cmaxValues10Prc, censoring = empCensoredvals10Prc)
cmaxValues10Prc[which.min(abs(empCensoredvals10Prc - censorPercentage1))]
