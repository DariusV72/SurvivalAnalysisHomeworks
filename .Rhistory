seed(123)
censorPercentage1 <- 0.1
censorPercentage2 <- 0.5
n1 <- 200
n2<- 500
lambda <- 0.05
#censoring dist family = uniform (for now)
times <- rexp(n1, lambda)
#find cmaxes
cmaxValues10Prc <- seq(1, max(times), by = 1)
empCensoredvals <- sapply(cmaxValues10Prc, function(cmax){
cnes <- runif(n, 0, cmax)
mean(times > cnes)
})
